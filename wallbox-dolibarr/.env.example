# ExpenseCharge standalone — Umgebung für docker compose
#
#   cp .env.example .env && nano .env
#   docker compose up -d --force-recreate
#
# .env ist per .gitignore vom Repo ausgeschlossen — sie darf Zugangsdaten enthalten.

TZ=Europe/Berlin
LOG_LEVEL=INFO

# Web-UI-Bindung auf dem Docker-Host:
#   127.0.0.1  nur lokal / per SSH-Tunnel (Standard)
#   0.0.0.0    im ganzen LAN/VPN — danach sofort die Ersteinrichtung im Browser
#              abschließen (Einrichtungscode: docker compose logs | grep Einrichtungscode)
WEB_BIND=127.0.0.1

# ── Optional: Konfiguration hier statt in data/options.json ──────────────
# Jede Option als EC_<OPTION> bzw. EC_<BEREICH>__<OPTION>, Listen als JSON.
# Hat Vorrang vor data/options.json. Zum Aktivieren das # entfernen.
#
# EC_SESSION_SOURCE=ocpp                       # alfen_http | ocpp | modbus
# EC_WALLBOX_ID=garage
# EC_API__DOLIBARR_URL=https://erp.firma.de
# EC_API__API_TOKEN=
# EC_RFID_WHITELIST=["EFCD083E","AABBCCDD"]
# EC_OCPP_CHARGE_POINTS=[{"id":"ACE0123456","password":"…","wallbox_id":"garage"}]
#
# Alfen HTTPS-API (EC_SESSION_SOURCE=alfen_http):
# EC_ALFEN__HOST=192.168.1.60
# EC_ALFEN__USERNAME=admin
# EC_ALFEN__PASSWORD=
#
# Modbus TCP (EC_SESSION_SOURCE=modbus):
# EC_MODBUS__HOST=
# EC_MODBUS__REGISTERS={"energy":{"address":0,"type":"uint32","word_order":"big","scale":0.001}}
