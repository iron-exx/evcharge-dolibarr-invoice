# ExpenseCharge — Konfiguration per Umgebungsvariablen (Standalone-Docker)
#
#   cp .env.example .env
#   nano .env                 # Werte eintragen, nicht benötigte Zeilen leer lassen
#   docker compose up -d
#
# Regeln:
#   EC_<OPTION>=wert              oberste Ebene        EC_SESSION_SOURCE=alfen_http
#   EC_<BEREICH>__<OPTION>=wert   api / alfen / modbus EC_ALFEN__HOST=192.168.1.60
#   Listen/Objekte als JSON       EC_RFID_WHITELIST=["EFCD083E","AABBCCDD"]
#   leer = nicht gesetzt (Vorgabe gilt). Keine Anführungszeichen um einfache Werte.
# Jede Option aus config.yaml lässt sich so setzen. Eine data/options.json ist
# optional; steht ein Wert in beiden, gewinnt die .env.
# .env enthält Zugangsdaten und ist per .gitignore vom Repo ausgeschlossen.

# ── Allgemein ────────────────────────────────────────────────────────────
TZ=Europe/Berlin
LOG_LEVEL=INFO
EC_WALLBOX_ID=garage

# Woher kommen die Ladevorgänge? alfen_http | ocpp | modbus
# (ha_sensors braucht Home Assistant und geht standalone nicht)
EC_SESSION_SOURCE=alfen_http

# ── Dolibarr ─────────────────────────────────────────────────────────────
EC_API__DOLIBARR_URL=https://erp.example.com
EC_API__API_TOKEN=
EC_API__TRANSMIT_INTERVAL=300

# ── Karten ───────────────────────────────────────────────────────────────
# Normalerweise leer lassen und Karten in der Web-UI (Tab "Karten") anlernen.
EC_RFID_WHITELIST=

# ── Alfen HTTPS-API (EC_SESSION_SOURCE=alfen_http) ───────────────────────
EC_ALFEN__HOST=
EC_ALFEN__USERNAME=admin
EC_ALFEN__PASSWORD=
EC_ALFEN__VERIFY_SSL=false
EC_ALFEN__POLL_INTERVAL=30
EC_ALFEN__TRANSACTION_INTERVAL=300

# ── OCPP 1.6J (EC_SESSION_SOURCE=ocpp) ───────────────────────────────────
# Wallbox verbindet sich mit ws://<Docker-Host>:9000/<id>; Passwort ≥ 16 Zeichen.
EC_OCPP_CHARGE_POINTS=
# Beispiel: EC_OCPP_CHARGE_POINTS=[{"id":"ACE0123456","password":"bitte-mindestens-16-zeichen","wallbox_id":"garage"}]
EC_OCPP_APPLY_RECOMMENDED_CONFIG=

# ── Modbus TCP (EC_SESSION_SOURCE=modbus) ────────────────────────────────
EC_MODBUS__HOST=
EC_MODBUS__PORT=
EC_MODBUS__UNIT_ID=
# Registerkarte als JSON, "energy" ist Pflicht:
EC_MODBUS__REGISTERS=
# Beispiel: EC_MODBUS__REGISTERS={"energy":{"address":0,"type":"uint32","word_order":"big","scale":0.001}}

# ── Feintuning (leer = Vorgabe) ──────────────────────────────────────────
EC_RFID_HOLD_SECONDS=
EC_MIN_SESSION_KWH=
EC_MAX_SESSION_HOURS=
