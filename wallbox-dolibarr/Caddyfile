# TLS-Proxy für das Heimladen (docker-compose-Profil "tls").
# Nicht ändern — gesteuert über die .env: TLS_DOMAIN, ADMIN_FROM.

{$TLS_DOMAIN} {
	# Wallboxen: wss://<TLS_DOMAIN>/ocpp/<Charge-Point-ID> → OCPP-Server
	@ocpp path /ocpp /ocpp/*
	handle @ocpp {
		reverse_proxy expensecharge:9000
	}

	# Verwaltung nur aus dem Firmennetz (Vorgabe: private Adressbereiche, also LAN/VPN).
	# Freigeben z.B. mit ADMIN_FROM="private_ranges 203.0.113.0/24".
	@outside not remote_ip {$ADMIN_FROM}
	handle @outside {
		respond "Die Verwaltung ist nur aus dem Firmennetz erreichbar." 403
	}

	handle {
		reverse_proxy expensecharge:8099
	}

	header Strict-Transport-Security "max-age=31536000"
}
